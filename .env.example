# 山西证券 sxsc_tushare token。本地纯 Python 使用 env=prd。
SXSC_TUSHARE_TOKEN=

# 公开版 Tushare Pro。与 SXSC_TUSHARE_TOKEN 不是同一枚，两边不通用。
# 2026-10-29 登记：积分 2100，有效期至 2026-11-03。不要用于全市场批量拉取。
TUSHARE_TOKEN=

# 开通邮件中的山西证券 Tushare 账户积分。不要和上面的 2100 混用。
SXSC_TUSHARE_POINTS=

# PTrade 正式交易系统。登录密码与券商交易密码相同。
PTRADE_PROD_ACCOUNT=
PTRADE_PROD_PASSWORD=

# PTrade 仿真交易系统。登录及交易密码为身份证后 6 位数字（不含字母）。
PTRADE_SIM_ACCOUNT=
PTRADE_SIM_PASSWORD=
